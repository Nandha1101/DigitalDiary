# Copy this file to .env and fill it in. Never share or upload .env.

# From MongoDB Atlas: Connect > Drivers. Replace <password> with your database user's password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# A long random secret. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional: if set, people need this code to create an account (good for friends-only).
SIGNUP_CODE=

# Optional: photo space per person in MB (default 40). Atlas free storage is 512 MB in total.
PHOTO_QUOTA_MB=40

# Set to production when deployed (needs https, which hosting sites provide).
NODE_ENV=development
